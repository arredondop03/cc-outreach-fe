# Playwright e2e settings. Copy to .env.test (git-ignored) and fill in.
# Must be a LOCAL database whose name ends in _test: the test run wipes it.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/cc_outreach_test?schema=public
# Test-only secret, never reuse the dev/prod one. Generate: openssl rand -base64 32
TEST_AUTH_SECRET=
# Admin account the test run seeds into the test database
TEST_ADMIN_EMAIL=e2e-admin@example.com
TEST_ADMIN_PASSWORD=some-8-char-password
